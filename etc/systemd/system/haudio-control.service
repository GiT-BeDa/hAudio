[Unit]
Description=HAUDIO control backend
After=pipewire.service wireplumber.service network-online.target
Wants=network-online.target
[Service]
Type=simple
User=haudio
Group=haudio
WorkingDirectory=/opt/haudio
ExecStart=/usr/bin/python3 -m uvicorn haudio_main:APP --host 0.0.0.0 --port 8765
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=8
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
